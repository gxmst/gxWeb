# Optional GitHub API token. Never commit a real token.
GITHUB_TOKEN=
GITHUB_API_TIMEOUT=20
TRANSLATE_API_TIMEOUT=15
PIPELINE_JOB_TIMEOUT_SECONDS=1800

# Linux only: set these to the owner of ./public (`id -u` / `id -g`) so the
# non-root spider process can write through the bind mount.
APP_UID=1000
APP_GID=1000
