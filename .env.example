# Optional GitHub API token. Never commit a real token.
GITHUB_TOKEN=
GITHUB_API_TIMEOUT=20
TRANSLATE_API_TIMEOUT=15
PIPELINE_JOB_TIMEOUT_SECONDS=1800

# Weather location used by Open-Meteo. Defaults to Shenyang.
WEATHER_LATITUDE=41.80
WEATHER_LONGITUDE=123.43

# Public NodeSeek / Linux DO RSS: seconds between polls, items per source.
FORUM_POLL_INTERVAL_SECONDS=300
FORUM_ITEMS_PER_SOURCE=50

# Optional webhook alerts for high-score breaking news or consecutive job failures.
ALERT_WEBHOOK_URL=
ALERT_MIN_SCORE=85
ALERT_COOLDOWN_SECONDS=1800
ALERT_CONSECUTIVE_FAILURES=3

# Blank disables admin writes. Use a unique password of at least 12 characters.
# Admin cookies default to strict HTTPS; set `auto` or `false` only for trusted plain HTTP LAN deployments.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=true
WEATHER_CITY=默认城市

# Bind to 127.0.0.1 when a host reverse proxy provides the public HTTPS entry.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=1881

# Linux only: set these to the owner of ./public (`id -u` / `id -g`) so the
# non-root spider process can write through the bind mount.
APP_UID=1000
APP_GID=1000
